# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=https://seiva.example.com
DEFAULT_LOCALE=pt-BR

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
# Modelo do agente. Nao trocar sem medir qualidade nas respostas de campo.
SEIVA_MODEL=claude-opus-5
# low | medium | high | xhigh | max — WhatsApp e latency-sensitive; medium e o padrao.
SEIVA_EFFORT=medium

# ---- WhatsApp: Meta Cloud API ----
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret do app Meta — usado para validar X-Hub-Signature-256. Obrigatorio em producao.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# ---- WhatsApp: Evolution API (dev/local, alternativa) ----
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ---- Postgres + PostGIS ----
DATABASE_URL=postgres://seiva:seiva@localhost:5432/seiva

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Sentinel Hub (Copernicus) ----
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_BASE_URL=https://services.sentinel-hub.com
# Acima disso a passagem e descartada como nublada (0..1).
SENTINEL_MAX_CLOUD_COVER=0.35

# ---- Clima ----
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ---- Audio (STT/TTS) ----
STT_PROVIDER=whisper_local
STT_BASE_URL=http://localhost:9000
TTS_PROVIDER=none
TTS_BASE_URL=
TTS_VOICE=pt-BR

# ---- Mercado ----
MARKET_PRICE_BASE_URL=
