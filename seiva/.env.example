# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=https://seiva.example.com
DEFAULT_LOCALE=pt-BR

# ---- Anthropic (Claude) ----
ANTHROPIC_API_KEY=
# Modelo do agente. Nao trocar sem medir qualidade nas respostas de campo.
SEIVA_MODEL=claude-opus-5
# low | medium | high | xhigh | max — WhatsApp e latency-sensitive; medium e o padrao.
SEIVA_EFFORT=medium

# ---- WhatsApp: Meta Cloud API ----
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret do app Meta — usado para validar X-Hub-Signature-256. Obrigatorio em producao.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# ---- WhatsApp: Evolution API (dev/local, alternativa) ----
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# ---- Postgres + PostGIS ----
DATABASE_URL=postgres://seiva:seiva@localhost:5432/seiva

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Sentinel Hub (Copernicus) ----
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
# Copernicus Data Space (conta gratis): https://sh.dataspace.copernicus.eu
# Sentinel Hub comercial:                https://services.sentinel-hub.com
SENTINEL_HUB_BASE_URL=https://sh.dataspace.copernicus.eu
# Acima disso a passagem e descartada como nublada (0..1).
SENTINEL_MAX_CLOUD_COVER=0.35

# ---- Clima ----
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ---- Audio (STT/TTS) ----
# Suba os servicos com: docker compose --profile audio up -d stt tts
# Depois troque STT_PROVIDER para whisper_local e TTS_PROVIDER para http.
# Sem STT o audio do produtor nao e transcrito — e a via preferida do
# publico-alvo, entao e a primeira integracao a ligar.
STT_PROVIDER=none
STT_BASE_URL=http://localhost:9000
TTS_PROVIDER=none
TTS_BASE_URL=http://localhost:5002
TTS_VOICE=pt-BR

# ---- Mercado ----
MARKET_PRICE_BASE_URL=
