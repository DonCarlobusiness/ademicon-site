{
  "name": "seiva",
  "version": "0.1.0",
  "private": true,
  "description": "SEIVA \u2014 Agronomo de Bolso no WhatsApp",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && node --watch dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --env-file=tests/test.env --test \"dist/tests/**/*.test.js\"",
    "migrate": "node dist/src/scripts/migrate.js",
    "test:db": "npm run build && SEIVA_TEST_DB=1 node --env-file=tests/test.env --test \"dist/tests/**/*.test.js\"",
    "doctor": "npm run build && node --env-file-if-exists=.env dist/src/scripts/doctor.js",
    "chat": "npm run build && node --env-file-if-exists=.env dist/src/scripts/chat.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "undici": "^7.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
