# DON INVEST — copie para .env.local. NUNCA coloque valores reais neste arquivo.

# Fuso horário de exibição (o banco/armazenamento usa UTC)
NEXT_PUBLIC_DISPLAY_TZ=America/Bahia

# Modo de recomendação individualizada regulada (CVM Res. 19/20). Mantenha false.
# Só pode ser habilitado com registro/autorização e revisão jurídica.
REGULATED_ADVICE_ENABLED=false

# Provedor licenciado de cotações de ações/FIIs/ETFs/REITs (ainda não integrado).
# Valores possíveis futuros: brapi | twelvedata | polygon | b3_licensed
QUOTES_PROVIDER=
QUOTES_API_KEY=

# Mentor conversacional opcional (Fase 2). Sem chave, o sistema roda em modo determinístico.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Supabase (Fase 2). Sem credenciais, relatórios ficam em .data/ local (modo limitado).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Limite de pesquisas por IP por minuto em /api/research
RESEARCH_RATE_LIMIT_PER_MIN=6
